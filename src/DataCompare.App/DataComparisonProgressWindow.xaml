<Window x:Class="DataCompare.App.DataComparisonProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DataCompare.App.ViewModels"
        Title="Comparing..." Width="420" Height="520" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TableProgressItem}">
            <StackPanel Orientation="Horizontal" Margin="4,3">
                <Grid Width="22" Height="18">
                    <!-- A rotating dashed ring reads as "in progress" much better than a static glyph
                         did — a full solid circle would look identical at every rotation angle, so
                         the dash gaps are what actually make the spin visible. -->
                    <Ellipse x:Name="Spinner" Width="14" Height="14" StrokeThickness="2" Stroke="#999999"
                             StrokeDashArray="2 2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="CheckMark" Text="&#10003;" FontWeight="Bold" Foreground="#2E8B2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <TextBlock Text="{Binding TableName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Summary}" Foreground="#888888" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding CompareStatusMessage}" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <Button DockPanel.Dock="Bottom" Content="Cancel" Padding="12,5" HorizontalAlignment="Right"
                Margin="0,10,0,0" Click="CancelButton_Click" />
        <ListBox ItemsSource="{Binding TableProgressItems}" BorderThickness="1" BorderBrush="#DDDDDD" />
    </DockPanel>
</Window>
