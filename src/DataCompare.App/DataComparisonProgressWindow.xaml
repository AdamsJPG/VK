<Window x:Class="DataCompare.App.DataComparisonProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DataCompare.App.ViewModels"
        Title="Comparing..." Width="420" Height="520" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- A rotating dashed ring reads as "in progress" much better than a static glyph did — a
             full solid circle would look identical at every rotation angle, so the dash gaps are
             what actually make the spin visible. Shared by both the table-level and chunk-level rows. -->
        <Style x:Key="SpinnerRingStyle" TargetType="Ellipse">
            <Setter Property="StrokeDashArray" Value="2 2" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- One key-range chunk of a partitioned large table (planning.md §19) — a smaller, indented
             version of the table-level row below. -->
        <DataTemplate x:Key="ChunkProgressItemTemplate" DataType="{x:Type vm:ChunkProgressItem}">
            <StackPanel Orientation="Horizontal" Margin="4,2">
                <Grid Width="18" Height="16">
                    <Ellipse x:Name="ChunkSpinner" Style="{StaticResource SpinnerRingStyle}"
                             Width="11" Height="11" StrokeThickness="1.5" Stroke="#AAAAAA" />
                    <TextBlock x:Name="ChunkCheckMark" Text="&#10003;" FontWeight="Bold" FontSize="10" Foreground="#2E8B2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter TargetName="ChunkSpinner" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ChunkCheckMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A table with no chunks (the common case) renders exactly like the old flat row — WPF's
             TreeView hides the expand arrow when ItemsSource is empty. A partitioned table's chunk
             sub-rows use ChunkProgressItemTemplate above via HierarchicalDataTemplate's implicit
             per-item-type template lookup. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:TableProgressItem}" ItemsSource="{Binding Chunks}">
            <Border x:Name="RowBackground" Padding="2">
                <StackPanel Orientation="Horizontal" Margin="4,3">
                    <Grid Width="22" Height="18">
                        <Ellipse x:Name="Spinner" Style="{StaticResource SpinnerRingStyle}"
                                 Width="14" Height="14" StrokeThickness="2" Stroke="#999999" />
                        <TextBlock x:Name="CheckMark" Text="&#10003;" FontWeight="Bold" Foreground="#2E8B2E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock Text="{Binding TableName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- Missing a real difference is the one failure mode this exercise cannot tolerate
                         (planning.md §19 addendum) — "Differences found" is deliberately loud (red,
                         bold, flashing) rather than styled the same as every other status message, so
                         it cannot be scanned past by accident. -->
                    <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Foreground="#888888"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDifferences}" Value="True">
                    <Setter TargetName="CheckMark" Property="Text" Value="&#9888;" />
                    <Setter TargetName="CheckMark" Property="Foreground" Value="Red" />
                    <Setter TargetName="CheckMark" Property="FontSize" Value="16" />
                    <Setter TargetName="SummaryText" Property="Foreground" Value="Red" />
                    <Setter TargetName="SummaryText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="SummaryText" Property="FontSize" Value="13" />
                    <Setter TargetName="RowBackground" Property="Background" Value="#FFE6E6" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="FlashDifferencesFoundStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SummaryText" Storyboard.TargetProperty="Opacity"
                                                  From="1.0" To="0.2" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity"
                                                  From="1.0" To="0.2" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="FlashDifferencesFoundStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- A schema-only table (exists on just one side) never goes through data comparison,
                     so it never earns a spinner — it's known to be a mismatch the instant it's added.
                     Orange keeps it visually distinct from the red "data differences found" case above. -->
                <DataTrigger Binding="{Binding IsSchemaOnly}" Value="True">
                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CheckMark" Property="Text" Value="!" />
                    <Setter TargetName="CheckMark" Property="Foreground" Value="#E08A00" />
                    <Setter TargetName="CheckMark" Property="FontSize" Value="16" />
                    <Setter TargetName="SummaryText" Property="Foreground" Value="#E08A00" />
                    <Setter TargetName="SummaryText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="SummaryText" Property="FontSize" Value="13" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="FlashSchemaOnlyStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SummaryText" Storyboard.TargetProperty="Opacity"
                                                  From="1.0" To="0.2" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity"
                                                  From="1.0" To="0.2" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="FlashSchemaOnlyStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding CompareStatusMessage}" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ElapsedTimeText}" Foreground="#888888"
                   FontSize="12" Margin="0,0,0,10" />
        <Button DockPanel.Dock="Bottom" Content="Cancel" Padding="12,5" HorizontalAlignment="Right"
                Margin="0,10,0,0" Click="CancelButton_Click" />
        <TreeView ItemsSource="{Binding TableProgressItems}" BorderThickness="1" BorderBrush="#DDDDDD" />
    </DockPanel>
</Window>
