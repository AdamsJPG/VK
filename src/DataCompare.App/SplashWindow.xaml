<Window x:Class="DataCompare.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Width="360" Height="240">
    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="12">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="96" Height="96" Margin="0,0,0,16">
                <Viewbox Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <TranslateTransform X="10" Y="10" />
                    </Viewbox.RenderTransform>
                    <Canvas Width="100" Height="100">
                        <Path Data="{StaticResource DatabaseCylinderGeometry}" Fill="{StaticResource AccentBrush}" />
                        <Path Data="{StaticResource DatabaseCylinderSeams}" Stroke="White" StrokeThickness="7" />
                    </Canvas>
                </Viewbox>
                <Viewbox>
                    <Canvas Width="100" Height="100">
                        <Path Data="{StaticResource DatabaseCylinderGeometry}" Fill="{StaticResource AccentBrush}" />
                        <Path Data="{StaticResource DatabaseCylinderSeams}" Stroke="White" StrokeThickness="7" />
                    </Canvas>
                </Viewbox>
            </Grid>
            <TextBlock Text="VK" FontSize="32" FontWeight="Bold" Foreground="#222222" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
