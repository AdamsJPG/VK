<Window x:Class="DataCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataCompare.App"
        xmlns:vm="clr-namespace:DataCompare.App.ViewModels"
        mc:Ignorable="d"
        Title="VK" Height="700" Width="1000">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate x:Key="ConnectionPanelTemplate" DataType="{x:Type vm:ConnectionSetupViewModel}">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Server" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                         Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2" Grid.Column="0" Content="Authentication" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" IsEnabled="False" SelectedIndex="0"
                          ToolTip="SQL Server Authentication only for now — Windows Authentication may be added later.">
                    <ComboBoxItem Content="SQL Server authentication" />
                </ComboBox>

                <Label Grid.Row="3" Grid.Column="0" Content="User name" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="4" Grid.Column="0" Content="Password" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="4" Grid.Column="1" Margin="8,0,0,8" x:Name="PasswordBox" />

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,8">
                    <CheckBox Content="Remember credentials" IsChecked="{Binding RememberCredentials}" VerticalAlignment="Center" />
                    <TextBlock Text="?" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="Gray"
                               Cursor="Help" ToolTipService.InitialShowDelay="200"
                               ToolTip="Stores the password securely in Windows Credential Manager for next time." />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,8">
                    <CheckBox Content="Encrypt" IsChecked="{Binding Encrypt}" Margin="0,0,12,0" />
                    <CheckBox Content="Trust server certificate" IsChecked="{Binding TrustServerCertificate}" />
                </StackPanel>

                <Label Grid.Row="7" Grid.Column="0" Content="Database" FontWeight="Bold" Margin="0,8,0,4" />
                <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" IsEditable="True" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding AvailableDatabases}" />
                    <Button Grid.Column="1" Content="&#8635;" FontSize="16" Padding="8,2" Margin="4,0,0,0"
                            ToolTip="Refresh database list from the server" Click="RefreshDatabasesButton_Click" Tag="{Binding}" />
                </Grid>

                <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Test Connection" FontSize="14" Padding="10,6" Click="TestConnectionButton_Click" Tag="{Binding}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="DiffTreeNodeTemplate" DataType="{x:Type vm:DiffTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
        </HierarchicalDataTemplate>

        <Style x:Key="DdlLineStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#D6F5D6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Placeholder top-level navigation, mirroring SQL Data Compare's layout — not wired to anything yet. -->
        <Style x:Key="TopNavLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Button Content="Data Sources" Style="{StaticResource TopNavLinkStyle}" Click="DataSourcesNavButton_Click" />
                <Button Content="Tables &amp; views" Style="{StaticResource TopNavLinkStyle}" IsEnabled="False" />
                <Button Content="Options" Style="{StaticResource TopNavLinkStyle}" IsEnabled="False" />
            </StackPanel>
        </Border>

        <Border x:Name="BottomToolbar" DockPanel.Dock="Bottom" Background="#2D2D2D">
            <DockPanel Margin="8,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding CompareStatusMessage}" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="360" />
                    <Button Content="Compare now" Margin="0,0,8,0" Padding="14,7" FontWeight="Bold" FontSize="14"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                            IsEnabled="{Binding CanCompare}" Click="CompareNowButton_Click" />
                    <Button Content="Cancel" FontSize="14" Style="{StaticResource ToolbarButtonStyle}" Click="CancelButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&#8594;" ToolTip="Copy source settings to target" Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="16" Command="{Binding CopySourceToTargetCommand}" />
                    <Button Content="&#8644;" ToolTip="Swap source and target" Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="16" Command="{Binding SwapSourceAndTargetCommand}" />
                    <Button Content="&#8592;" ToolTip="Copy target settings to source" Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="16" Command="{Binding CopyTargetToSourceCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- Data Sources screen -->
            <DockPanel x:Name="DataSourcesBody">
                <Grid x:Name="ChevronBanner" DockPanel.Dock="Top" Height="170" SizeChanged="ChevronBanner_SizeChanged">
                    <Rectangle Fill="{StaticResource AccentBrush}" />
                    <Polygon x:Name="SourceBannerPolygon" Fill="#F0F0F0" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Source" FontWeight="Bold" FontSize="20" Foreground="#222222"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,14,0,0" />
                        <StackPanel Grid.Column="0" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,46,0,0">
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                                <Canvas Width="100" Height="100">
                                    <Path Data="{StaticResource DatabaseCylinderGeometry}" Fill="#333333" />
                                    <Path Data="{StaticResource DatabaseCylinderSeams}" Stroke="White" StrokeThickness="7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding ConnectionA.ServerName}" ToolTip="{Binding ConnectionA.ServerName}"
                                       FontSize="12" Foreground="#222222" HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Target" FontWeight="Bold" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0" />
                        <StackPanel Grid.Column="1" Width="160" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,20,0">
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                                <Canvas Width="100" Height="100">
                                    <Path Data="{StaticResource DatabaseCylinderGeometry}" Fill="White" />
                                    <Path Data="{StaticResource DatabaseCylinderSeams}" Stroke="#CCCCCC" StrokeThickness="7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding ConnectionB.ServerName}" ToolTip="{Binding ConnectionB.ServerName}"
                                       FontSize="12" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ContentControl x:Name="SourceContentControl" Grid.Column="0" Content="{Binding ConnectionA}" ContentTemplate="{StaticResource ConnectionPanelTemplate}" />
                    <Rectangle Grid.Column="1" Fill="#DDDDDD" />
                    <ContentControl x:Name="TargetContentControl" Grid.Column="2" Content="{Binding ConnectionB}" ContentTemplate="{StaticResource ConnectionPanelTemplate}" />
                </Grid>
            </DockPanel>

            <!-- Results screen — same window, swapped in when Compare now finishes -->
            <Grid x:Name="ResultsBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="&#8592; Back to Data Sources" Margin="8" Padding="8,4"
                                Click="BackToDataSourcesButton_Click" />
                        <Button Content="Export to HTML..." Margin="0,8,8,8" Padding="8,4"
                                Click="ExportHtmlButton_Click" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0F0F0" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ConnectionA.ServerName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ConnectionA.DatabaseName}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource AccentBrush}" Padding="16,10">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ConnectionB.ServerName}" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ConnectionB.DatabaseName}" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Margin="8,6" TextWrapping="Wrap" Text="{Binding SchemaComparisonStatus}" />

                <!-- ListView+GridView (not a plain ListBox/Grid) so columns are actually draggable to
                     resize, and the last column is stretched on SizeChanged so the table fills the
                     window instead of leaving dead space when maximized. -->
                <ListView x:Name="SchemaListView" Grid.Row="2" Margin="8,4"
                          ItemsSource="{Binding SchemaRowsView}" SelectionChanged="SchemaListBox_SelectionChanged"
                          SizeChanged="SchemaListView_SizeChanged">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#EDEDED" Padding="6,5" Margin="0,4,0,0">
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Name" />
                                                    <Binding Path="ItemCount" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Type" Width="50" DisplayMemberBinding="{Binding TypeLabel}" />
                            <GridViewColumn Header="Last modified" Width="120" DisplayMemberBinding="{Binding SourceModifiedDisplay}" />
                            <GridViewColumn Header="Owner" Width="60" DisplayMemberBinding="{Binding SourceOwnerDisplay}" />
                            <GridViewColumn Header="Object name (Source)" Width="220" DisplayMemberBinding="{Binding SourceNameDisplay}" />
                            <GridViewColumn Header="Object name (Target)" Width="220" DisplayMemberBinding="{Binding TargetNameDisplay}" />
                            <GridViewColumn Header="Owner" Width="60" DisplayMemberBinding="{Binding TargetOwnerDisplay}" />
                            <GridViewColumn Header="Last modified" Width="120" DisplayMemberBinding="{Binding TargetModifiedDisplay}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="#DDDDDD" />

                <DockPanel Grid.Row="4" Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="4" FontWeight="Bold" Text="{Binding SelectedSchemaObjectHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SourceDdlLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource DdlLineStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Rectangle Grid.Column="1" Fill="#DDDDDD" />

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TargetDdlLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource DdlLineStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
